<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Investigación de Campo - Telecomunicaciones Venezuela</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f4f6f9; margin: 0; padding: 15px; color: #333; }
        .form-container { max-width: 100%; background: #ffffff; margin: 0 auto; padding: 20px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        h2 { text-align: center; color: #0056b3; margin-bottom: 5px; font-size: 1.4rem; }
        p.subtitle { text-align: center; color: #666; margin-bottom: 25px; font-size: 0.9rem; }
        fieldset { border: 1px solid #ddd; border-radius: 6px; padding: 15px; margin-bottom: 20px; }
        legend { font-weight: bold; color: #0056b3; padding: 0 8px; font-size: 0.95rem; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; font-size: 0.85rem; }
        input[type="text"], input[type="email"], select, textarea { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 0.95rem; background-color: #fff; }
        input[readonly] { background-color: #e9ecef; color: #495057; cursor: not-allowed; }
        .checkbox-group { display: flex; flex-direction: column; gap: 10px; margin-top: 5px; }
        .checkbox-item { display: flex; align-items: center; font-size: 0.9rem; background: #f8f9fa; padding: 10px; border-radius: 4px; border: 1px solid #eee; }
        .checkbox-item input { margin-right: 12px; transform: scale(1.2); }
        button { width: 100%; background-color: #0056b3; color: white; border: none; padding: 16px; font-size: 1.1rem; font-weight: bold; border-radius: 4px; cursor: pointer; }
        .gps-status { font-size: 0.8rem; color: #28a745; margin-top: 5px; font-weight: bold; }
    </style>
</head>
<body>
<div class="form-container">
    <h2>Ficha de Investigación de Conectividad</h2>
    <p class="subtitle">Diagnóstico de Fallas y Debilidades de Telecomunicaciones en Venezuela</p>
    <form action="https://formspree.io" method="POST" enctype="multipart/form-data">
        <fieldset>
            <legend>1. Datos del Usuario Afectado</legend>
            <div class="form-group"><label for="nombre">Nombre Completo:</label><input type="text" id="nombre" name="Nombre" required></div>
            <div class="form-group"><label for="cedula">Cédula de Identidad:</label><input type="text" id="cedula" name="Cedula" required placeholder="V-00000000"></div>
            <div class="form-group"><label for="email_user">Correo Electrónico:</label><input type="email" id="email_user" name="Email_Usuario" required></div>
        </fieldset>
        <fieldset>
            <legend>2. Ubicación de la Falla</legend>
            <div class="form-group"><label for="estado">Estado:</label><input type="text" id="estado" name="Estado" required value="Cojedes"></div>
            <div class="form-group"><label for="municipio">Municipio / Parroquia:</label><input type="text" id="municipio" name="Municipio_Parroquia" required value="San Carlos"></div>
            <div class="form-group"><label for="direccion">Dirección Exacta (Sector, Calle, Referencia):</label><textarea id="direccion" name="Direccion_Detallada" rows="2" required></textarea></div>
            <div class="form-group"><label for="coordenadas">Ubicación GPS en Tiempo Real:</label><input type="text" id="coordenadas" name="Coordenadas_GPS" readonly placeholder="Obteniendo coordenadas exactas..."><div id="status-gps" class="gps-status">⌛ Buscando señal de satélite GPS...</div></div>
        </fieldset>
        <fieldset>
            <legend>3. Servicios Afectados y Proveedores</legend>
            <div class="form-group">
                <label for="codigo_cantv">Código de Área Local (Fijo CANTV):</label>
                <select id="codigo_cantv" name="Codigo_Area_Local">
                    <option value="0258" selected>0258 - Cojedes</option>
                    <option value="0212">0212 - Dto. Capital, Miranda, La Guaira</option>
                    <option value="0241">0241 / 0242 - Carabobo</option>
                    <option value="0243">0243 - Aragua</option>
                    <option value="0251">0251 - Lara</option>
                    <option value="0261">0261 - Zulia</option>
                    <option value="0276">0276 - Táchira</option>
                </select>
            </div>
            <div class="form-group">
                <label>Operadoras Móviles:</label>
                <div class="checkbox-group">
                    <div class="checkbox-item"><input type="checkbox" name="Operadora_Movil[]" value="Movistar"> Movistar (0414/0424)</div>
                    <div class="checkbox-item"><input type="checkbox" name="Operadora_Movil[]" value="Movilnet"> Movilnet (0416/0426)</div>
                    <div class="checkbox-item"><input type="checkbox" name="Operadora_Movil[]" value="Digitel"> Digitel (0412)</div>
                </div>
            </div>
            <div class="form-group">
                <label>Proveedores de Internet / Fibra Óptica:</label>
                <div class="checkbox-group">
                    <div class="checkbox-item"><input type="checkbox" name="Internet_Proveedor[]" value="CANTV Aba"> CANTV (Aba Cobre)</div>
                    <div class="checkbox-item"><input type="checkbox" name="Internet_Proveedor[]" value="CANTV Aba Ultra"> CANTV (Aba Ultra Fibra)</div>
                    <div class="checkbox-item"><input type="checkbox" name="Internet_Proveedor[]" value="Inter"> Inter</div>
                    <div class="checkbox-item"><input type="checkbox" name="Internet_Proveedor[]" value="Thundernet"> Thundernet</div>
                    <div class="checkbox-item"><input type="checkbox" name="Internet_Proveedor[]" value="Fibex"> Fibex Telecom</div>
                </div>
            </div>
        </fieldset>
        <fieldset>
            <legend>4. Reporte Técnico de la Falla</legend>
            <div class="form-group">
                <label>Tipo de Problema:</label>
                <div class="checkbox-group">
                    <div class="checkbox-item"><input type="checkbox" name="Tipo_Falla[]" value="Sin Tono"> Sin tono fijo</div>
                    <div class="checkbox-item"><input type="checkbox" name="Tipo_Falla[]" value="Averia Internet"> Avería de Internet</div>
                    <div class="checkbox-item"><input type="checkbox" name="Tipo_Falla[]" value="Lentitud"> Navegación lenta</div>
                    <div class="checkbox-item"><input type="checkbox" name="Tipo_Falla[]" value="Sin Senal Movil"> Sin señal celular</div>
                </div>
            </div>
            <div class="form-group"><label for="foto_falla">Evidencia Fotográfica:</label><input type="file" id="foto_falla" name="Evidencia_Fotografica" accept="image/*" multiple></div>
        </fieldset>
        <button type="submit">Enviar Encuesta y Respaldar en Correo</button>
    </form>
</div>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    document.getElementById('coordenadas').value = `${position.coords.latitude}, ${position.coords.longitude}`;
                    document.getElementById('status-gps').innerText = "✅ Ubicación capturada con éxito";
                },
                (error) => {
                    document.getElementById('status-gps').innerText = "❌ GPS encendido.";
                    document.getElementById('status-gps').style.color = "#dc3545";
                    document.getElementById('coordenadas').removeAttribute('readonly');
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        }
    });
</script>
</body>
</html>
